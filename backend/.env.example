# Server
NODE_ENV=development
PORT=5000
# Frontend origin allowed by CORS (e.g. your Vercel URL)
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/medimanage

# Auth (use long random strings, e.g. `openssl rand -hex 32`)
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Redis (optional, app runs without it)
REDIS_URL=

# Cloudinary (prescription/receipt PDFs, lab reports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP, optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLINIC_NAME=MediManage

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
